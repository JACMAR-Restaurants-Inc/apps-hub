# Copy to .env.local and fill in. Never commit the real file.
# Staging and production have SEPARATE values for every line below.

# Supabase Postgres, from Connect → Direct → URI. KEY=value, no spaces, no [brackets].
# DATABASE_URL: Transaction pooler (6543), for the app.
# DIRECT_URL: Session pooler (5432), for migrations. Not "Direct connection": IPv6-only.
DATABASE_URL=
DIRECT_URL=

# Email routing. Anything other than exactly "live" sends everything to the test
# inbox, with the real recipients shown in the subject. Staging stays "test" until
# leadership approves the switch.
EMAIL_MODE=test
EMAIL_TEST_INBOX=sony@jacmar-restaurants.com

# Sending email: a Google service account with domain-wide delegation for ONE scope,
# https://www.googleapis.com/auth/gmail.send (it can send, not read). The value is the
# JSON key file, base64-encoded onto one line:  base64 -i key.json | tr -d '\n'
# GMAIL_SENDER is the Workspace mailbox the emails come from.
GMAIL_SERVICE_ACCOUNT=
GMAIL_SENDER=

# Google sign-in (Better Auth). One OAuth client, consent screen External + published.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Clearview (HR). The client secret expires 2027-11-23.
CLEARVIEW_CLIENT_ID=
CLEARVIEW_CLIENT_SECRET=
CLEARVIEW_AUTH_KEY=
